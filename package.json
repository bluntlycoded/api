{
  "name": "fraudshield-api",
  "version": "1.0.0",
  "description": "Authenticator backend with risk-based login approval",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --import ./tests/setup.js --test tests/*.test.js",
    "migrate": "node scripts/migrate.js",
    "evaluate:risk": "node --import ./tests/setup.js scripts/evaluate-risk.js",
    "dev:memory": "node scripts/dev-memory.js",
    "check:db": "node scripts/check-db.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "@solana/web3.js": "^1.98.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.1",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.15",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14",
    "socket.io-client": "^4.8.4"
  }
}
