# Required
DATABASE_URL=              # Supabase: Project Settings > Database > Connection string (use the pooler URL)
JWT_SECRET=                # long random string, e.g. openssl rand -hex 32
ENCRYPTION_KEY=            # 64 hex chars (32 bytes), e.g. openssl rand -hex 32. Losing it makes stored secrets unreadable.

# Server
PORT=2700
DATABASE_SSL=true          # set to false only for a local Postgres
TRUST_PROXY=               # number of proxies in front (e.g. 1). Needed for correct IPs behind a load balancer.
ALLOWED_ORIGINS=           # comma-separated web origins; empty allows any and disables the origin risk signal

# Passkeys (routes return 501 until both are set)
WEBAUTHN_RP_ID=            # your site's domain, e.g. example.com
WEBAUTHN_ORIGINS=          # comma-separated origins that may use passkeys, e.g. https://example.com
WEBAUTHN_RP_NAME=FraudShield Authenticator

# VPN / proxy / datacentre detection (optional)
IP_RANGES_FILE=            # path to a file of CIDR ranges, one per line

# Password reset email (without SMTP_HOST the token is printed to the console outside production)
PASSWORD_RESET_URL=        # page that accepts ?token=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional
REFRESH_REUSE_LEEWAY_SECONDS=10   # grace window for a just-used refresh token; 0 makes any reuse end the login
TOTP_ISSUER=FraudShield Authenticator
SOLANA_RPC_URL=https://api.devnet.solana.com
